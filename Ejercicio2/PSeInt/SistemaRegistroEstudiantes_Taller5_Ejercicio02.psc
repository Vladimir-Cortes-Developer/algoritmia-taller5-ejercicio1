Algoritmo SistemaCalificacionesUniversitarias
    // Declaración de variables globales
    Definir nombres Como Caracter
    Definir notas Como Real
    Definir promedios Como Real
    Definir i Como Entero
    Dimension nombres[5]
    Dimension notas[5,4]  // 5 estudiantes, 4 notas cada uno
    Dimension promedios[5]
    
    // Título del sistema
    Limpiar Pantalla
    Escribir "????????????????????????????????????????????????????"
    Escribir "?  SISTEMA DE CALIFICACIONES UNIVERSITARIAS       ?"
    Escribir "????????????????????????????????????????????????????"
    Escribir ""
    Esperar 1 Segundos
    
    // Registro de estudiantes y calificaciones
    RegistrarEstudiantes(nombres, notas)
    
    // Calcular promedios de todos los estudiantes
    Para i <- 0 Hasta 4 Hacer
        promedios[i] <- CalcularPromedioEstudiante(notas, i)
    FinPara
    
    // Mostrar reporte completo
    MostrarReporteCompleto(nombres, notas, promedios)
    
    Escribir ""
    Escribir "Presione ENTER para finalizar..."
    Esperar Tecla
    
FinAlgoritmo

// ============================================
// PROCEDIMIENTO: Registrar Estudiantes y Notas
// ============================================
SubProceso RegistrarEstudiantes(nombres Por Referencia, notas Por Referencia)
    Definir i, j Como Entero
    Definir nota Como Real
    Definir notaValida Como Logico
    
    Limpiar Pantalla
    Escribir "????????????????????????????????????????????????????"
    Escribir "?        REGISTRO DE ESTUDIANTES Y NOTAS          ?"
    Escribir "????????????????????????????????????????????????????"
    Escribir ""
    
    Para i <- 0 Hasta 4 Hacer
        Escribir "?? ESTUDIANTE ", i+1, " de 5 ???????????????????????????"
        
        // Ingreso del nombre
        Escribir Sin Saltar "? Nombre: "
        Leer nombres[i]
        Escribir "?"
        
        // Ingreso de 4 notas con validación
        Para j <- 0 Hasta 3 Hacer
            notaValida <- Falso
            
            Repetir
                Escribir Sin Saltar "? Nota ", j+1, " (0.0 - 5.0): "
                Leer nota
                
                Si nota >= 0 Y nota <= 5.0 Entonces
                    notas[i,j] <- nota
                    notaValida <- Verdadero
                SiNo
                    Escribir "? ? Error: La nota debe estar entre 0.0 y 5.0"
                FinSi
            Hasta Que notaValida = Verdadero
        FinPara
        
        Escribir "??????????????????????????????????????????????????"
        Escribir ""
    FinPara
    
    Escribir "? Todos los estudiantes registrados exitosamente."
    Esperar 2 Segundos
FinSubProceso

// ============================================
// FUNCIÓN: Calcular Promedio de un Estudiante
// ============================================
Funcion promedio <- CalcularPromedioEstudiante(notas, indiceEstudiante)
    Definir suma, promedio Como Real
    Definir j Como Entero
    
    suma <- 0
    
    Para j <- 0 Hasta 3 Hacer
        suma <- suma + notas[indiceEstudiante, j]
    FinPara
    
    promedio <- suma / 4
FinFuncion

// ============================================
// FUNCIÓN BOOLEANA: Determinar si Aprueba
// ============================================
Funcion aprueba <- VerificarAprobacion(promedio)
    Definir aprueba Como Logico
    
    Si promedio >= 3.0 Entonces
        aprueba <- Verdadero
    SiNo
        aprueba <- Falso
    FinSi
FinFuncion

// ============================================
// FUNCIÓN: Calcular Promedio General de Todos
// ============================================
Funcion promedioGeneral <- CalcularPromedioGeneral(promedios, tamanio)
    Definir suma, promedioGeneral Como Real
    Definir i Como Entero
    
    suma <- 0
    
    Para i <- 0 Hasta tamanio-1 Hacer
        suma <- suma + promedios[i]
    FinPara
    
    promedioGeneral <- suma / tamanio
FinFuncion

// ============================================
// FUNCIÓN: Encontrar Nota Más Alta
// ============================================
Funcion notaMaxima <- EncontrarNotaMaxima(notas, numEstudiantes, numNotas)
    Definir notaMaxima Como Real
    Definir i, j Como Entero
    
    notaMaxima <- notas[0,0]
    
    Para i <- 0 Hasta numEstudiantes-1 Hacer
        Para j <- 0 Hasta numNotas-1 Hacer
            Si notas[i,j] > notaMaxima Entonces
                notaMaxima <- notas[i,j]
            FinSi
        FinPara
    FinPara
FinFuncion

// ============================================
// FUNCIÓN: Encontrar Nota Más Baja
// ============================================
Funcion notaMinima <- EncontrarNotaMinima(notas, numEstudiantes, numNotas)
    Definir notaMinima Como Real
    Definir i, j Como Entero
    
    notaMinima <- notas[0,0]
    
    Para i <- 0 Hasta numEstudiantes-1 Hacer
        Para j <- 0 Hasta numNotas-1 Hacer
            Si notas[i,j] < notaMinima Entonces
                notaMinima <- notas[i,j]
            FinSi
        FinPara
    FinPara
FinFuncion

// ============================================
// FUNCIÓN: Clasificar Rendimiento del Estudiante
// ============================================
Funcion clasificacion <- ClasificarEstudiante(promedio)
    Definir clasificacion Como Caracter
    
    Si promedio >= 4.5 Entonces
        clasificacion <- "EXCELENTE"
    SiNo
        Si promedio >= 3.5 Entonces
            clasificacion <- "BUENO"
        SiNo
            Si promedio >= 3.0 Entonces
                clasificacion <- "ACEPTABLE"
            SiNo
                clasificacion <- "REPROBADO"
            FinSi
        FinSi
    FinSi
FinFuncion

// ============================================
// FUNCIÓN: Obtener Símbolo de Estado
// ============================================
Funcion simbolo <- ObtenerSimboloEstado(promedio)
    Definir simbolo Como Caracter
    
    Si promedio >= 4.5 Entonces
        simbolo <- "???"
    SiNo
        Si promedio >= 3.5 Entonces
            simbolo <- "??"
        SiNo
            Si promedio >= 3.0 Entonces
                simbolo <- "?"
            SiNo
                simbolo <- "?"
            FinSi
        FinSi
    FinSi
FinFuncion

// ============================================
// PROCEDIMIENTO: Mostrar Reporte Completo
// ============================================
SubProceso MostrarReporteCompleto(nombres, notas, promedios)
    Definir i, j Como Entero
    Definir promedioGral, notaMax, notaMin Como Real
    Definir clasificacion, estado, simbolo Como Caracter
    Definir aprobados, reprobados Como Entero
    
    Limpiar Pantalla
    
    // Calcular estadísticas generales
    promedioGral <- CalcularPromedioGeneral(promedios, 5)
    notaMax <- EncontrarNotaMaxima(notas, 5, 4)
    notaMin <- EncontrarNotaMinima(notas, 5, 4)
    
    aprobados <- 0
    reprobados <- 0
    
    Para i <- 0 Hasta 4 Hacer
        Si VerificarAprobacion(promedios[i]) Entonces
            aprobados <- aprobados + 1
        SiNo
            reprobados <- reprobados + 1
        FinSi
    FinPara
    
    // Encabezado del reporte
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir "?           REPORTE ACADÉMICO - SISTEMA UNIVERSITARIO             ?"
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir ""
    
    // Reporte individual de cada estudiante
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir "?                    CALIFICACIONES POR ESTUDIANTE                 ?"
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir ""
    
    Para i <- 0 Hasta 4 Hacer
        clasificacion <- ClasificarEstudiante(promedios[i])
        simbolo <- ObtenerSimboloEstado(promedios[i])
        
        Si VerificarAprobacion(promedios[i]) Entonces
            estado <- "APROBADO ?"
        SiNo
            estado <- "REPROBADO ?"
        FinSi
        
        Escribir "??????????????????????????????????????????????????????????????????"
        Escribir "? Estudiante: ", nombres[i]
        Escribir "??????????????????????????????????????????????????????????????????"
        Escribir "? Notas:"
        
        Para j <- 0 Hasta 3 Hacer
            Escribir "?   Nota ", j+1, ": ", notas[i,j]
        FinPara
        
        Escribir "??????????????????????????????????????????????????????????????????"
        Escribir "? Promedio: ", promedios[i]
        Escribir "? Estado: ", estado
        Escribir "? Clasificación: ", clasificacion, " ", simbolo
        Escribir "??????????????????????????????????????????????????????????????????"
        Escribir ""
    FinPara
    
    // Clasificación por categorías
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir "?              CLASIFICACIÓN POR RENDIMIENTO ACADÉMICO             ?"
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir ""
    
    // EXCELENTE (>=4.5)
    Escribir "??? EXCELENTE (Promedio >= 4.5):"
    Para i <- 0 Hasta 4 Hacer
        Si promedios[i] >= 4.5 Entonces
            Escribir "    ? ", nombres[i], " - Promedio: ", promedios[i]
        FinSi
    FinPara
    Escribir ""
    
    // BUENO (>=3.5)
    Escribir "??  BUENO (Promedio >= 3.5):"
    Para i <- 0 Hasta 4 Hacer
        Si promedios[i] >= 3.5 Y promedios[i] < 4.5 Entonces
            Escribir "    ? ", nombres[i], " - Promedio: ", promedios[i]
        FinSi
    FinPara
    Escribir ""
    
    // ACEPTABLE (>=3.0)
    Escribir "?   ACEPTABLE (Promedio >= 3.0):"
    Para i <- 0 Hasta 4 Hacer
        Si promedios[i] >= 3.0 Y promedios[i] < 3.5 Entonces
            Escribir "    ? ", nombres[i], " - Promedio: ", promedios[i]
        FinSi
    FinPara
    Escribir ""
    
    // REPROBADO (<3.0)
    Escribir "?   REPROBADO (Promedio < 3.0):"
    Para i <- 0 Hasta 4 Hacer
        Si promedios[i] < 3.0 Entonces
            Escribir "    ? ", nombres[i], " - Promedio: ", promedios[i]
        FinSi
    FinPara
    Escribir ""
    
    // Estadísticas generales
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir "?                     ESTADÍSTICAS GENERALES                       ?"
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir "? Total de estudiantes: 5                                         ?"
    Escribir "? Estudiantes aprobados: ", aprobados, "                                        ?"
    Escribir "? Estudiantes reprobados: ", reprobados, "                                       ?"
    Escribir "?                                                                  ?"
    Escribir "? Promedio general del curso: ", promedioGral, "                               ?"
    Escribir "? Nota más alta: ", notaMax, "                                            ?"
    Escribir "? Nota más baja: ", notaMin, "                                            ?"
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir ""
    
    // Análisis del rendimiento del curso
    Escribir "????????????????????????????????????????????????????????????????????"
    Escribir "?                    ANÁLISIS DEL CURSO                            ?"
    Escribir "????????????????????????????????????????????????????????????????????"
    
    Si promedioGral >= 4.0 Entonces
        Escribir "   ? El curso presenta un EXCELENTE rendimiento académico."
    SiNo
        Si promedioGral >= 3.5 Entonces
            Escribir "   ? El curso presenta un BUEN rendimiento académico."
        SiNo
            Si promedioGral >= 3.0 Entonces
                Escribir "   ? El curso presenta un rendimiento ACEPTABLE."
            SiNo
                Escribir "   ? El curso requiere ATENCIÓN - Rendimiento bajo."
            FinSi
        FinSi
    FinSi
    
    Escribir ""
    
    Si aprobados > reprobados Entonces
        Escribir "   La mayoría de estudiantes aprobó la materia."
    SiNo
        Si aprobados = reprobados Entonces
            Escribir "   El número de aprobados y reprobados es igual."
        SiNo
            Escribir "   ? La mayoría de estudiantes reprobó la materia."
        FinSi
    FinSi
    
FinSubProceso